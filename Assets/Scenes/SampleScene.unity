  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Objetivo:\r\nCompletar el rally: sumar la mayor cantidad de puntos encontrando
    la pieza correcta en cada una de las 12 secciones del museo para terminar el
    recorrido.\n\nInstrucciones:\n\u25CF Se te dar\xE1 una pista para que busques
    una pieza del museo en una secci\xF3n determinada.\n\u25CF Cuando creas saber
    cu\xE1l pieza es la correcta, acerca tu camara hacia la tarjeta oficial para
    valorar tu respuesta.\n\u25CF En caso de acertar, otra pista aparecer\xE1 para
    que busques una nueva pieza, esta se encontrar\xE1 en la siguiente secci\xF3n
    del museo.\n\u25CF Tienes 3 intentos para resolver la pista, en caso de terminarte
    los intentos, avanzar\xE1s a la siguiente pista automaticamente.\n\u25CF No es
    un juego de velocidad as\xED que toma tu tiempo para disfrutar del recorrido
    del museo."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
